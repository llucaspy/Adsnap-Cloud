generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Campaign {
  id                   String          @id @default(cuid())
  agency               String
  client               String
  campaignName         String          @default("")
  pi                   String
  format               String
  url                  String
  device               String          @default("desktop")
  status               String          @default("PENDING")
  segmentation         String          @default("PRIVADO")
  flightStart          DateTime?
  flightEnd            DateTime?
  isArchived           Boolean         @default(false)
  isScheduled          Boolean         @default(false)
  scheduledTimes       String          @default("[]")
  lastCaptureAt        DateTime?
  retryCount           Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  externalAuthUrl      String?
  externalCampaignId   String?
  isMonitoringActive   Boolean         @default(false)
  manualDashboardUrl   String?
  dailyGoalThreshold   Int?
  lastThresholdAlertAt DateTime?
  showOnDashboard      Boolean         @default(false)
  allowedChannels      String?         @default("[]")
  externalChannelId    String?
  isMultiChannel       Boolean         @default(false)
  lastDelivered        Int             @default(0)
  lastFetchedAt        DateTime?
  lastGoal             Int             @default(0)
  lastViewability      Float           @default(0)
  compositionBox       Json?
  captures             Capture[]
  emailDispatches      EmailDispatch[]
}

model Capture {
  id             String   @id @default(cuid())
  campaignId     String
  screenshotPath String
  status         String   @default("SUCCESS")
  auditNotes     String?
  createdAt      DateTime @default(now())
  isAssembly     Boolean  @default(false)
  baseCaptureId  String?
  aiAuditStatus  String?  @default("PENDING")
  aiDiagnostic   String?
  aiScore        Int?
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Settings {
  id                    Int       @id @default(1)
  nexusMaxRetries       Int       @default(3)
  nexusTimeout          Int       @default(60000)
  nexusDelay            Int       @default(3000)
  autoCleanupDays       Int       @default(30)
  webhookUrl            String?
  performanceMode       Boolean   @default(false)
  feedPollingRate       Int       @default(5000)
  maintenanceMode       Boolean   @default(false)
  bannerFormats         String    @default("[]")
  updatedAt             DateTime  @updatedAt
  storageCheckFrequency Int       @default(24)
  storageCheckLastRun   DateTime?
  telegramBotToken      String?
  telegramChatId        String?
  telegramAlertsEnabled Boolean   @default(true)
  telegramLastAlertAt   DateTime?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NexusLog {
  id         String   @id @default(cuid())
  level      String
  message    String
  details    String?
  campaignId String?
  createdAt  DateTime @default(now())
}

model EmailDispatch {
  id           String    @id @default(cuid())
  campaignId   String?
  recipients   String
  dispatchTime String    @default("09:00")
  isActive     Boolean   @default(true)
  lastSentAt   DateTime?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  pi           String    @default("")
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model NexusMessage {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  role        String
  content     String
  metadata    Json?    @default("{}")
  sessionId   String   @default("default")
  isProcessed Boolean? @default(false)
  createdAt   DateTime @default(now())
}

model DailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime @default(now())
  delivered   Int
  viewability Float
  goal        Int
  pacing      Float
  createdAt   DateTime @default(now())

  @@unique([campaignId, date])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model NexusEvolutionLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  description String
  metadata    Json?     @default("{}")
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
}

model NexusKnowledge {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String                 @unique(map: "nexus_knowledge_content_unique")
  embedding Unsupported("vector")?
  metadata  Json?                  @default("{}")
  createdAt DateTime?              @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model NexusSecrets {
  name      String    @id
  value     String
  createdat DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model NexusSettings {
  sessionId      String    @id
  preferredModel String?
  updatedAt      DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nexus_memory_log {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp       DateTime? @default(now()) @db.Timestamptz(6)
  type            String
  title           String
  details         String?
  tools_used      String[]
  result          String?
  impact          String?
  requires_review Boolean?  @default(false)
  metadata        Json?     @default("{}")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nexus_memory_summary {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime? @unique @default(dbgenerated("CURRENT_DATE")) @db.Date
  summary   Json
  createdat DateTime? @default(now()) @db.Timestamptz(6)
}
